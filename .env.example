# Backend Environment Variables Example
# Copy this file to backend/.env and fill in your actual values

# Server Configuration
PORT=5000

# Database Configuration
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/ai_lms

# Or MongoDB Atlas (recommended for production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_lms?retryWrites=true&w=majority

# Authentication
# Generate a secure random string (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_to_something_secure

# OpenRouter AI Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter Model (optional, defaults to free model)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ML Service URL
ML_SERVICE_URL=http://localhost:8000
